<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v5 source for the oflm installer.
  Ports src/inno/oflm.iss (Inno Setup) to an MSI package.

  Build (from src/wix), via the script that also stages the payload:
    powershell -ExecutionPolicy Bypass -File build.ps1 -Version 1.2.3
  or by hand:
    cmd /c get_files.bat
    wix build oflm.wxs -arch x64 -ext WixToolset.UI.wixext -d ProductVersion=1.2.3 -out oflm-setup.msi

  ProductVersion has no default worth having: an MSI whose version is 0.0.0
  installs, upgrades nothing, and is indistinguishable from every other 0.0.0.
  It is a required input, and the release workflow takes it from the tag.

  Not ported 1:1 from oflm.iss:
    - The interactive "model storage location" / "server port" wizard pages are
      not reproduced. OFLM_MODEL_PATH and OFLM_SERVE_PORT are written with the
      same defaults Inno used (%USERPROFILE%\.oflm and 52625) but are not
      prompted for during install.
    - The desktop shortcuts ("oflm run" / "oflm serve") are an opt-in MSI
      feature (Level="1000", not installed by default) instead of an
      unchecked wizard checkbox, since there is no custom UI here to host one.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!-- get_files.bat (run by build.ps1 and by the release workflow) stages the
       payload into this directory, and empties it first. It used to be
       $(SourceDir), which is src/inno, a directory get_files.bat does not
       write to, so the build read whichever oflm.exe an older inno/get_files.bat
       run had left there. It is "package" and not "." on purpose: "." would glob
       this .wxs, build.ps1, get_files.bat and the output\*.msi into Program
       Files. -->
  <?define PackageDir = "package"?>
  <!-- Tracked installer assets (icon, licence), not staged. -->
  <?define SourceDir = "..\inno"?>
  <?define XclbinsDir = "..\xclbins"?>
  <!-- Overridden by the release workflow: -d ProductVersion=1.2.3 -->
  <?ifndef ProductVersion ?>
    <?define ProductVersion = "0.0.0" ?>
  <?endif?>

  <Package Name="oflm"
           Manufacturer="OpenFlowLM"
           Version="$(ProductVersion)"
           UpgradeCode="5A5B2872-1E63-4934-9F57-088554CF4959"
           Language="1033"
           Scope="perMachine"
           Compressed="yes">

    <SummaryInformation Description="oflm installer" Manufacturer="OpenFlowLM" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of oflm is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon.ico" SourceFile="$(SourceDir)\logo.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://www.openflowlm.com" />

    <WixVariable Id="WixUILicenseRtf" Value="$(SourceDir)\terms.rtf" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <ui:WixUI Id="WixUI_InstallDir" />

    <!-- Directory layout -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="oflm">
        <Directory Id="XCLBINSFOLDER" Name="xclbins" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="oflm" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <!-- Environment: OFLM_MODEL_PATH, OFLM_SERVE_PORT, PATH -->
    <!-- Attached to the main exe's component so it is set/removed with install/uninstall. -->

    <!-- Features -->
    <Feature Id="MainFeature" Title="oflm" Level="1">
      <ComponentGroupRef Id="MainComponents" />
      <ComponentGroupRef Id="XclbinsComponents" />
      <ComponentGroupRef Id="ApplicationShortcuts" />
    </Feature>

    <Feature Id="DesktopShortcutsFeature" Title="Desktop shortcuts" Level="1000">
      <ComponentGroupRef Id="DesktopShortcuts" />
    </Feature>

    <ComponentGroup Id="MainComponents" Directory="INSTALLFOLDER">

      <!-- The staged payload, by glob rather than by list. It was 45 explicit
           <Component>/<File> pairs, which is a claim about what the installer
           ships that nothing checked: a new engine library, or the vcpkg
           runtime DLLs a vcpkg-toolchain build links against, was missing from
           the MSI until somebody remembered to add it, and the installed
           oflm.exe then failed at load with a missing DLL. The xclbins group
           below has always done it this way. get_files.bat empties the
           directory first, so this glob is exactly the payload. -->
      <Files Include="$(PackageDir)\**" />

      <!-- The environment, on a registry key rather than on a file: a component
           keyed on a File stops being "installed" when the file is there, and
           with <Files> there is no single file to key on. -->
      <Component Id="Comp_environment" Guid="*">
        <RegistryValue Root="HKLM" Key="Software\OpenFlowLM\oflm" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <Environment Id="Env_Path" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="yes" Permanent="no" />
        <Environment Id="Env_ModelPath" Name="OFLM_MODEL_PATH" Value="%USERPROFILE%\.oflm" Action="set" System="yes" Permanent="no" />
        <Environment Id="Env_ServePort" Name="OFLM_SERVE_PORT" Value="52625" Action="set" System="yes" Permanent="no" />
      </Component>

    </ComponentGroup>

    <!-- xclbins\* recursively, mirrors oflm.iss's recursesubdirs Source entry -->
    <ComponentGroup Id="XclbinsComponents" Directory="XCLBINSFOLDER">
      <Files Include="$(XclbinsDir)\**" />
    </ComponentGroup>

    <!-- Start Menu shortcut: always installed -->
    <ComponentGroup Id="ApplicationShortcuts" Directory="ApplicationProgramsFolder">
      <Component Id="Comp_StartMenuShortcut" Guid="*">
        <Shortcut Id="StartMenuShortcut"
                  Name="oflm"
                  Description="Launch oflm"
                  Target="[INSTALLFOLDER]oflm.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKLM" Key="Software\OpenFlowLM\oflm" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Desktop shortcuts: opt-in feature (DesktopShortcutsFeature, Level 1000) -->
    <ComponentGroup Id="DesktopShortcuts" Directory="DesktopFolder">
      <Component Id="Comp_DesktopShortcutRun" Guid="*">
        <Shortcut Id="DesktopShortcutRun"
                  Name="oflm run"
                  Description="Launch oflm with llama3.2:1b model"
                  Target="[%ComSpec]"
                  Arguments="/K &quot;[INSTALLFOLDER]oflm.exe&quot; run llama3.2:1b"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico" />
        <RegistryValue Root="HKLM" Key="Software\OpenFlowLM\oflm" Name="DesktopShortcutRun" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="Comp_DesktopShortcutServe" Guid="*">
        <Shortcut Id="DesktopShortcutServe"
                  Name="oflm serve"
                  Description="Launch oflm in serve mode"
                  Target="[%ComSpec]"
                  Arguments="/K &quot;[INSTALLFOLDER]oflm.exe&quot; serve"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico" />
        <RegistryValue Root="HKLM" Key="Software\OpenFlowLM\oflm" Name="DesktopShortcutServe" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

  </Package>
</Wix>
