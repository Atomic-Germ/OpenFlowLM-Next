# Included before targets and third-party subdirectories, including for -S src.
if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
    return()
endif()

option(OFLM_USE_MOLD "Use mold for Linux C/C++ linking when available" ON)
option(OFLM_USE_CCACHE "Cache Linux C/C++ compilation with ccache when available" ON)

if(OFLM_USE_CCACHE)
    find_program(OFLM_CCACHE_EXECUTABLE NAMES ccache)
    if(OFLM_CCACHE_EXECUTABLE)
        foreach(_lang C CXX)
            # Preserve a launcher explicitly supplied by the user/toolchain.
            if(NOT DEFINED CMAKE_${_lang}_COMPILER_LAUNCHER)
                set(CMAKE_${_lang}_COMPILER_LAUNCHER "${OFLM_CCACHE_EXECUTABLE}")
            endif()
            message(STATUS "OFLM ${_lang} compiler launcher: ${CMAKE_${_lang}_COMPILER_LAUNCHER}")
        endforeach()
    else()
        message(STATUS "OFLM: ccache not found; compilation cache disabled (install ccache)")
    endif()
endif()

if(OFLM_USE_MOLD)
    find_program(OFLM_MOLD_EXECUTABLE NAMES mold)
    if(OFLM_MOLD_EXECUTABLE AND CMAKE_CXX_COMPILER_ID MATCHES "^(GNU|Clang)$")
        include(CheckLinkerFlag)
        check_linker_flag(CXX "-fuse-ld=mold" OFLM_HAS_MOLD_LINKER)
        if(OFLM_HAS_MOLD_LINKER)
            add_link_options("$<$<LINK_LANGUAGE:C,CXX>:-fuse-ld=mold>")
            message(STATUS "OFLM Linux linker: mold")
        else()
            message(WARNING "OFLM: compiler cannot link with -fuse-ld=mold; using the configured linker")
        endif()
    else()
        message(STATUS "OFLM: mold unavailable for this compiler; using the configured linker (install mold for GCC/Clang)")
    endif()
endif()
